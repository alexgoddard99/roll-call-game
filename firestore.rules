rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user results (senate: results/, court: courtResults/) — owner only.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Crowd counters: one doc per game per day, e.g. senate-2026-08-27,
    // court-2026-08-27 (dev previews write to senate-dev-… / court-dev-…).
    // Flat integer counters: n (completions), s0..s15 (score histogram),
    // v0..v14 (per-vote correct counts), t1..t30 (current-streak histogram,
    // t30 = 30 days or more). Anyone may read, and anyone may add exactly one
    // completion — n+1, exactly one score bucket +1, any subset of the other
    // counters +1 — via FieldValue.increment(1). Nothing else is writable and
    // docs can never be deleted from a client.
    match /daily/{id} {
      function allowedKeys() {
        return ['n', 's0', 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9', 's10', 's11', 's12', 's13', 's14', 's15', 'v0', 'v1', 'v2', 'v3', 'v4', 'v5', 'v6', 'v7', 'v8', 'v9', 'v10', 'v11', 'v12', 'v13', 'v14', 't1', 't2', 't3', 't4', 't5', 't6', 't7', 't8', 't9', 't10', 't11', 't12', 't13', 't14', 't15', 't16', 't17', 't18', 't19', 't20', 't21', 't22', 't23', 't24', 't25', 't26', 't27', 't28', 't29', 't30'];
      }
      function validId() {
        return id.matches('^(senate|court)(-dev)?-[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      // a key is either untouched, or exactly old + 1 (a = affected key set)
      function inc(a, k) {
        return !(k in a)
            || request.resource.data[k] == resource.data.get(k, 0) + 1;
      }
      function validUpdate() {
        let a = request.resource.data.diff(resource.data).affectedKeys();
        return a.hasOnly(allowedKeys())
          && request.resource.data.keys().hasAll(resource.data.keys())
          && request.resource.data.n == resource.data.n + 1
          && a.intersection(['s0', 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9', 's10', 's11', 's12', 's13', 's14', 's15'].toSet()).size() == 1
          && inc(a, 's0')
          && inc(a, 's1')
          && inc(a, 's2')
          && inc(a, 's3')
          && inc(a, 's4')
          && inc(a, 's5')
          && inc(a, 's6')
          && inc(a, 's7')
          && inc(a, 's8')
          && inc(a, 's9')
          && inc(a, 's10')
          && inc(a, 's11')
          && inc(a, 's12')
          && inc(a, 's13')
          && inc(a, 's14')
          && inc(a, 's15')
          && inc(a, 'v0')
          && inc(a, 'v1')
          && inc(a, 'v2')
          && inc(a, 'v3')
          && inc(a, 'v4')
          && inc(a, 'v5')
          && inc(a, 'v6')
          && inc(a, 'v7')
          && inc(a, 'v8')
          && inc(a, 'v9')
          && inc(a, 'v10')
          && inc(a, 'v11')
          && inc(a, 'v12')
          && inc(a, 'v13')
          && inc(a, 'v14')
          && inc(a, 't1')
          && inc(a, 't2')
          && inc(a, 't3')
          && inc(a, 't4')
          && inc(a, 't5')
          && inc(a, 't6')
          && inc(a, 't7')
          && inc(a, 't8')
          && inc(a, 't9')
          && inc(a, 't10')
          && inc(a, 't11')
          && inc(a, 't12')
          && inc(a, 't13')
          && inc(a, 't14')
          && inc(a, 't15')
          && inc(a, 't16')
          && inc(a, 't17')
          && inc(a, 't18')
          && inc(a, 't19')
          && inc(a, 't20')
          && inc(a, 't21')
          && inc(a, 't22')
          && inc(a, 't23')
          && inc(a, 't24')
          && inc(a, 't25')
          && inc(a, 't26')
          && inc(a, 't27')
          && inc(a, 't28')
          && inc(a, 't29')
          && inc(a, 't30');
      }

      allow read: if true;
      allow delete: if false;

      allow create: if validId()
        && request.resource.data.keys().hasOnly(allowedKeys())
        && request.resource.data.n == 1
        && request.resource.data.values().hasOnly([1]);

      allow update: if validId() && validUpdate();
    }
  }
}
